[Unit]
Description=Jetson Nano llama.cpp Server
After=network-online.target docker.service
Wants=network-online.target
RequiresMountsFor=/data

[Service]
Type=simple
User=root
WorkingDirectory=/data/llama.cpp
ExecStart=/usr/local/sbin/start-jetson-llama-server.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
